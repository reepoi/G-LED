{
    "$schema": "https://raw.githubusercontent.com/mfussenegger/dapconfig-schema/master/dapconfig-schema.json",
    "version": "0.2.0",
    "configurations": [
        {
            "type": "python",
            "request": "launch",
            "name": "Train sequential",
            "program": "/home/ttransue/GitHub/G-LED/src/g_led/data/data_bfs_preprocess.py",
            "args": [
                "rng_seed=0",
                "model=TransformerBackwardFacingStep2D",
                "dataset=BackwardFacingStep2D"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "${input:gpu}"
            }
        },
        {
            "type": "python",
            "request": "launch",
            "name": "Train upsampler",
            "program": "/home/ttransue/GitHub/G-LED/src/g_led/main_upsampler.py",
            "args": [
                "dataset=KuramotoSivashinsky1DSize1",
                "model=ImagenKuramotoSivashinsky1D",
                "dataset.batch_size_train=1",
                "dataset.batch_size_val=1",
                "dataset.time_step_window_size_train=null",
                "dataset.time_step_window_size_val=null",
                "dataset.trajectory_count_train=1",
                "dataset.trajectory_count_val=1",
                "dataset.trajectories_are_shared_across_splits=true"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "${input:gpu}"
            }
        },
        {
            "type": "python",
            "request": "launch",
            "name": "Debug dataset",
            "program": "/home/ttransue/GitHub/G-LED/src/g_led/datasets.py",
            "args": [
                "+experiment=EvalTrainedImagenBackwardFacingStep2D",
                "model.conf=yli80x1e",
                "model.ckpt_filename=epoch_0.ckpt",
                "dataset=Macro",
                "model@dataset.model=Trained",
                "dataset.model.conf=rj700zkc",
                "dataset.model.ckpt_filename=epoch_217__forecast_time_step_count_91.ckpt",
                "dataset.split=TRAIN",
                "dataset.initial_sequence_time_step_start=0",
                "dataset.initial_sequence_time_step_count=1"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "${input:gpu}"
            }
        },
        {
            "type": "python",
            "request": "launch",
            "name": "Run temp",
            "program": "/home/ttransue/GitHub/G-LED/src/g_led/temp.py",
            "args": [
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "${input:gpu}"
            }
        }
    ],
    "inputs": [
        {
            "id": "gpu",
            "type": "promptString",
            "description": "Pick a GPU"
        }
    ]
}
